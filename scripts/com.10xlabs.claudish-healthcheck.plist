<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.10xlabs.claudish-healthcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jack/mag/claudish/scripts/healthcheck-launchd.sh</string>
    </array>

    <!-- 07:00 local time, every day. launchd tracks local time, so this follows
         the AEST/AEDT changeover on its own - no cron to re-point in October. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/jack/mag/claudish</string>

    <key>StandardOutPath</key>
    <string>/Users/jack/mag/claudish/logs/health/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jack/mag/claudish/logs/health/launchd.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
